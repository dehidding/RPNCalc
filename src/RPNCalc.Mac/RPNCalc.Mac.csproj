<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RPNCalc</AssemblyName>
    <RootNamespace>RPNCalc.Mac</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>

    <Product>RPN Calculator</Product>
    <Version>1.1.2</Version>
    <Copyright>Copyright © David Hidding 2026</Copyright>
    <Description>HP-style RPN calculator - macOS (Avalonia) version of the 1997 Delphi RPNCalc</Description>

    <!-- Publish: dotnet publish -r osx-arm64|osx-x64 -c Release (see build/package-mac.sh) -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPNCalc.Engine\RPNCalc.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <InternalsVisibleTo Include="RPNCalc.Mac.Tests" />
    <!-- Source shared with the Android front end -->
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
